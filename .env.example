# Copy this file to .env and fill in your values.
# .env is gitignored and will not be committed.

# --- neuPrint (required for tutorials 00, 01, 05 and the gallery) ---
NEUPRINT_SERVER_URL=https://neuprint.janelia.org/
NEUPRINT_DATASET_NAME=male-cns:v1.0
# Your personal token from https://neuprint.janelia.org/account (keep it secret)
NEUPRINT_APPLICATION_CREDENTIALS=your_token_here

# --- Data sources for neuron meshes and brain shells (plotting) ---
SEGMENTATION_SOURCE='precomputed://gs://flyem-male-cns/v1.0/segmentation'
SHELL_SOURCE='gs://flyem-optic-lobe/rois/fullbrain-major-shells/'

# --- Optional: notebook plotting backends ---
PLOTLY_RENDERER=notebook
NAVIS_JUPYTER_PLOT3D_BACKEND=plotly

# --- Optional: use a local connectome_interpreter checkout instead of the installed one ---
# CI_DEV_PATH=/path/to/connectome_interpreter
